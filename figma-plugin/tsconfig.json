{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2021", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "typeRoots": ["../node_modules/@types", "../node_modules/@figma"]
  },
  "include": ["src/**/*.ts", "../electron/shared/**/*.ts"]
}
