{
  "version": 1,
  "providers": [
    {
      "id": "meta",
      "kind": "openai-compatible",
      "displayName": "Meta Model API",
      "baseUrl": "https://api.meta.ai/v1",
      "auth": "bearer",
      "segmentPath": "/responses",
      "maxOutputTokens": 32000
    },
    {
      "id": "doppl-demo",
      "kind": "doppl-demo",
      "displayName": "Doppl demo access",
      "serves": "meta",
      "maxOutputTokens": 24000,
      "maxCallsPerCreation": 15
    }
  ],
  "models": [
    {
      "id": "muse-spark-1.3",
      "provider": "meta",
      "displayName": "Muse Spark 1.3",
      "capabilities": {
        "tools": true,
        "structuredOutput": true,
        "vision": true,
        "reasoningEffort": ["minimal", "low", "medium", "high", "xhigh", "max"],
        "contextWindow": 1048576
      },
      "location": "cloud",
      "pricing": { "inputPerM": 1.25, "cachedInputPerM": 0.15, "outputPerM": 4.25 },
      "quirks": ["alphabeticalFields"],
      "dataPolicy": { "trainsOnData": false },
      "enabled": true
    },
    {
      "id": "muse-spark-1.3-contributor",
      "provider": "meta",
      "displayName": "Muse Spark 1.3 (Contributor)",
      "capabilities": {
        "tools": true,
        "structuredOutput": true,
        "vision": true,
        "reasoningEffort": ["minimal", "low", "medium", "high", "xhigh"],
        "contextWindow": 1048576
      },
      "location": "cloud",
      "pricing": { "inputPerM": 0.1, "cachedInputPerM": 0.002, "outputPerM": 0.2 },
      "quirks": ["alphabeticalFields"],
      "dataPolicy": { "trainsOnData": true },
      "enabled": false
    },
    {
      "id": "sam-3.1",
      "provider": "meta",
      "displayName": "SAM 3.1",
      "capabilities": {
        "tools": false,
        "structuredOutput": false,
        "vision": true,
        "contextWindow": 0,
        "segmentation": true
      },
      "location": "cloud",
      "pricing": { "inputPerM": 0, "outputPerM": 0, "perImage": 0.0025 },
      "quirks": [],
      "dataPolicy": { "trainsOnData": false },
      "enabled": true
    }
  ]
}
